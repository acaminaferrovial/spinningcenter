# Server Environment Variables
PORT=3001
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/spinningcenter

# JWT - replace with a long random string in production
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES=7d

# AES-256 encryption key - must be exactly 32 characters
ENCRYPTION_KEY=change_me_32_char_encryption_key

# Spotify OAuth - get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/auth/spotify/callback
